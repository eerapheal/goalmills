# -------------------------------------------------------------
# GoalMills Enterprise Admin Suite Environment Configuration
# -------------------------------------------------------------
MONGODB_URL="mongodb+srv://username:password@cluster.mongodb.net/goalmills"
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your_nextauth_secret_key

# Public Web and Admin URLs
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mailing Microservice Engine
MAILER_SERVICE_URL=http://localhost:8085
CRON_SECRET=your_secure_cron_secret

# Media Assets & CDN (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security & Admin Notification Key
ADMIN_NOTIFICATION_KEY=your_admin_secret_key
