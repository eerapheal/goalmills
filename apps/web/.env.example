# -------------------------------------------------------------
# Database & Authentication
# -------------------------------------------------------------
MONGODB_URL="mongodb+srv://username:password@cluster.mongodb.net/goalmills"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key

# Public Web URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------
# Enterprise Mailing & Deliverability Engine Configuration
# -------------------------------------------------------------
MAILER_SERVICE_URL=http://localhost:8085
CRON_SECRET=your_secure_cron_secret

# SMTP Provider Credentials (AWS SES, SendGrid, Resend, Postmark, or Custom)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=newsletter@goalmills.com
SMTP_FROM_NAME="GoalMills Sports Media"

# -------------------------------------------------------------
# Media Assets & CDN (Cloudinary)
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -------------------------------------------------------------
# Sports Data Provider APIs
# -------------------------------------------------------------
ALLSPORTS_API_KEY=your_allsports_api_key

# API-Football (v3) Web Configuration
NEXT_PUBLIC_API_FOOTBALL_KEY_WEB=
API_FOOTBALL_KEY_WEB=
NEXT_PUBLIC_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# API-Basketball (v1) Web Configuration
NEXT_PUBLIC_API_BASKETBALL_KEY_WEB=
API_BASKETBALL_KEY_WEB=
NEXT_PUBLIC_API_BASKETBALL_BASE_URL=https://v1.basketball.api-sports.io

# API-Cricket Web Configuration
NEXT_PUBLIC_CRICKET_API_KEY=
CRICKET_API_KEY=
NEXT_PUBLIC_CRICKET_BASE_URL=https://cricbuzz-cricket.p.rapidapi.com

# -------------------------------------------------------------
# Redis Caching Configuration (Optional - Memory Fallback active)
# -------------------------------------------------------------
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------------------------------------------
# Push Notifications (FCM / Firebase & Expo Push API)
# -------------------------------------------------------------
FIREBASE_SERVER_KEY=
FCM_SERVER_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
EXPO_ACCESS_TOKEN=
ADMIN_NOTIFICATION_KEY=your_admin_notification_secret

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
