# ==============================================================================
# GoalMills Social Engine — Environment Configuration
# ==============================================================================

# ── Core ──
NODE_ENV=development
PORT=4000
SOCIAL_ENGINE_PORT=4000

# ── Database (reuse existing MongoDB) ──
MONGODB_URL=mongodb://localhost:27017/goalmills_dev

# ── Redis (for match state tracking & rate limiting) ──
REDIS_URL=redis://localhost:6379

# ── Football Data Provider (AllSportsAPI — reuse existing key) ──
FOOTBALL_API_KEY=your_allsportsapi_key
FOOTBALL_BASE_URL=https://apiv2.allsportsapi.com/football

# ── AI Text Generation (Google Gemini — Free Tier: 15 RPM, 1500 RPD) ──
GEMINI_API_KEY=your_gemini_api_key

# ── Image Storage (Cloudinary — reuse existing) ──
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── X / Twitter (API v2 Free Tier — 1,500 tweets/month) ──
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Telegram (Bot API — 100% Free, unlimited) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@goalmills

# ── WhatsApp (Business Cloud API — 1,000 conversations/month free) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Facebook (Graph API — Page posting) ──
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ── LinkedIn (Marketing API — Organization posting) ──
LINKEDIN_ORG_ID=
LINKEDIN_ACCESS_TOKEN=

# ── YouTube (Data API v3 — 10K quota/day) ──
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── TikTok (Content Posting API — video only) ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── GoalMills Site URL (for image links in posts) ──
SITE_URL=https://goalmills.com
