{
  "name": "goalmills",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-sport platform monorepo with React Native and Next.js",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "web": "turbo run dev --filter=web",
    "mobile": "turbo run dev --filter=mobile"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@8.10.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
