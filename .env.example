# ==============================================================================
# GoalMills Sports Intelligence Platform — Master Environment Template
# ==============================================================================
# NOTE: This file contains ONLY non-sensitive placeholders.
# Do NOT place production secrets or private credentials in this file.
# Copy this file to .env or app-specific .env files for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
MAILER_PORT=8085

# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api
MAILER_SERVICE_URL=http://localhost:8085

# ------------------------------------------------------------------------------
# 2. DATABASE & STORAGE (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017/goalmills_dev

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED CACHING (Redis Cloud / Upstash / Local)
# ------------------------------------------------------------------------------
# Primary Connection String (Supports TLS rediss:// for production)
REDIS_URL=redis://localhost:6379

# Discrete Parameters (Fallback)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (Admin Hub Only)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_jwt_secret_key_here
NEXTAUTH_URL=http://localhost:3001
CRON_SECRET=your_secure_cron_webhook_secret_key_here
ADMIN_NOTIFICATION_KEY=your_admin_notification_api_key_here

# ------------------------------------------------------------------------------
# 5. SPORTS DATA PROVIDERS (Server-Side Only — NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# AllSportsAPI (Football, Basketball)
FOOTBALL_API_KEY=your_allsportsapi_key_here
FOOTBALL_BASE_URL=https://apiv2.allsportsapi.com/football
BASKETBALL_BASE_URL=https://apiv2.allsportsapi.com/basketball

# API-Football / API-Sports (Fixtures & Standings)
API_FOOTBALL_KEY_WEB=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Cricbuzz RapidAPI (Cricket)
CRICKET_API_KEY=your_cricbuzz_rapidapi_key_here
CRICKET_BASE_URL=https://cricbuzz-cricket.p.rapidapi.com

# ------------------------------------------------------------------------------
# 6. PUSH NOTIFICATION SERVICES (Firebase Cloud Messaging & Expo)
# ------------------------------------------------------------------------------
# Public Firebase Web Push Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_fcm_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_fcm_web_push_vapid_key

# Server-Side Push Keys
FIREBASE_SERVER_KEY=your_firebase_cloud_messaging_server_key
EXPO_ACCESS_TOKEN=your_expo_push_access_token

# ------------------------------------------------------------------------------
# 7. EMAIL & MAILER SERVICE (Golang Microservice & SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@example.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM_EMAIL=no-reply@goalmills.com
SMTP_FROM_NAME="GoalMills Sports Intelligence"

# ------------------------------------------------------------------------------
# 8. MEDIA & ASSET STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
